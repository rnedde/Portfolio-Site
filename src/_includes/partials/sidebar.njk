<aside class="sidebar border-1">
  <!-- Site title/name -->
  <div class="sidebar-section sidebar-header">
    <h1><a href="/">Reverie Nedde</a></h1>
  </div>

  <!-- Works list section -->
  <div class="sidebar-section works-index">
    <h3>Works</h3>
    <ul class="works-list">
      {% for work in collections.works %}
        <li class="{% if page.url == work.url %}active{% endif %}">
          <a href="{{ work.url }}">{{ work.data.title }}</a>
        </li>
      {% endfor %}
    </ul>
  </div>

  <!-- About link section -->
  <div class="sidebar-section">
    <h3><a href="/about/" class="{% if page.url == '/about/' %}active{% endif %}">About</a></h3>
  </div>

  <!-- Contact link section -->
  <div class="sidebar-section">
    <h3><a href="/contact/" class="{% if page.url == '/contact/' %}active{% endif %}">Contact</a></h3>
  </div>
</aside>
