<aside class="sidebar">
  <!-- Site title/name -->
  <div class="sidebar-section sidebar-header border-1">
    <a href="/"><h1>Reverie Nedde</h1></a>
  </div>

  <!-- Works list section -->
  <div class="sidebar-section works-index border-1">
    <a href="/"><h2>Works</h2></a>
    <ul class="works-list">
      {% for work in collections.works | reverse %}
        <li class="{% if page.url == work.url %}active{% endif %}">
          <a href="{{ work.url }}">{{ work.data.title }}</a>
        </li>
      {% endfor %}
    </ul>
  </div>

  <!-- About link section -->
  <div class="sidebar-section about-section border-1">
    <a href="/about/" class="{% if page.url == '/about/' %}active{% endif %}"><h2>About</h2></a>
  </div>

  <!-- Contact link section -->
  <div class="sidebar-section contact-section border-1">
    <a href="/contact/" class="{% if page.url == '/contact/' %}active{% endif %}"><h2>Contact</h2></a>
  </div>

  <!-- Footer section -->
  <div class="sidebar-section sidebar-footer border-1">
    <p>
      Made with <a href="https://www.11ty.dev/" target="_blank" rel="noopener noreferrer">Eleventy</a>,
      hosted on <a href="https://vercel.com/" target="_blank" rel="noopener noreferrer">Vercel</a>.
      This site was <a href="https://jeffhuang.com/designed_to_last/" target="_blank" rel="noopener noreferrer">Designed to last</a>.
    </p>
    <p>
      Fonts: <a href="https://haskoy.ertekinn.com/?ref=uncut.wtf" target="_blank" rel="noopener noreferrer">Haskoy</a>,
      <a href="https://uncut.wtf/display/phosphene/" target="_blank" rel="noopener noreferrer">Phosphène</a>.
    </p>
    <p>
      <a href="https://themarkup.org/blacklight?url=reverienedde.com&device=mobile&location=us-ca&force=false" target="_blank">
        No data collection.
      </a></p>
    <p class="copyright">Reverie Nedde 2026</p>
  </div>
</aside>
