{% extends "layouts/base.njk" %}

{% block content %}
<div class="work-body center-contents">
    <p class="short-description">
        {{ description }}
    </p>

    <div class="work-detail center-contents">
        <img src="{{ image }}" class="work-image border-1" alt="{{ title }} image" />

        <div class="description">
            {{ content | safe }}

            <div class="project-links">
                {% if blog_link %}
                    <p><a href="{{ blog_link }}" target="_blank">READ THE BLOG POST</a></p>
                {% endif %}

                {% if work_link %}
                    <p><a href="{{ work_link }}" target="_blank">VIEW PROJECT</a></p>
                {% endif %}

                {% if github_link %}
                    <p><a href="{{ github_link }}" target="_blank">SOURCE CODE</a></p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% endblock %}