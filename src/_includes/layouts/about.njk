<!DOCTYPE html>
<html lang="en">
  <head>

    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Reverie - {{ title }}</title>
    <link rel="stylesheet" href="/assets/styles.css"/>
    <link rel="icon" href="/images/favicon.png" type="image/png">

  </head>
  <body>

    <!-- Mobile Navigation -->
    <nav class="mobile-nav">
      <a href="/" class="mobile-nav-section mobile-nav-title"><h1>Reverie Nedde</h1></a>
      <div class="mobile-works-dropdown">
        <button class="mobile-nav-section mobile-works-toggle" aria-expanded="false">Works</button>
        <ul class="mobile-works-list">
          {% for work in collections.works | reverse %}
            <li class="{% if page.url == work.url %}active{% endif %}">
              <a href="{{ work.url }}">{{ work.data.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
      <a href="/about/" class="mobile-nav-section mobile-nav-link {% if page.url == '/about/' %}active{% endif %}">About</a>
      <a href="/contact/" class="mobile-nav-section mobile-nav-link {% if page.url == '/contact/' %}active{% endif %}">Contact</a>
    </nav>

    <div class="two-column-layout">
      {% include "partials/sidebar.njk" %}

      <div class="main-column">
        <main class="main-content border-1">
          <h2>{{ title }}</h2>
          {{ content | safe }}
        </main>

        <footer class="about-footer border-1">
          <p>
            Made with <a href="https://www.11ty.dev/" target="_blank" rel="noopener noreferrer">Eleventy</a>,
            hosted on <a href="https://vercel.com/" target="_blank" rel="noopener noreferrer">Vercel</a>.
            This site was <a href="https://jeffhuang.com/designed_to_last/" target="_blank" rel="noopener noreferrer">Designed to last</a>.
          </p>
          <p>
            Fonts: <a href="https://haskoy.ertekinn.com/?ref=uncut.wtf" target="_blank" rel="noopener noreferrer">Haskoy</a>,
            <a href="https://uncut.wtf/display/phosphene/" target="_blank" rel="noopener noreferrer">Phosphène</a>.
          </p>
          <p>
            <a href="https://themarkup.org/blacklight?url=reverienedde.com&device=mobile&location=us-ca&force=false" target="_blank">No data collection.</a>
          </p>
          <p class="copyright">© Reverie Nedde 2026</p>
        </footer>
      </div>
    </div>

    <script src="/assets/router.js"></script>
    <script src="/assets/mobile-nav.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.4/p5.min.js"></script>
    <script src="/assets/mousehover.js"></script>
    <script src="/assets/sparkle.js"></script>
    <script src="/assets/gradients.js"></script>
  </body>
</html>
